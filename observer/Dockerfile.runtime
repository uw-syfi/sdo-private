# syntax=docker/dockerfile:1.7

FROM golang:1.24.5-bookworm@sha256:ef8c5c733079ac219c77edab604c425d748c740d8699530ea6aced9de79aea40 AS go-runtime
WORKDIR /opt/sdo
COPY observer/sdk ./observer/sdk
COPY observer/core ./observer/core
COPY observer/controller ./observer/controller
COPY observer/updater ./observer/updater
RUN cd observer/sdk && go mod download all
RUN cd observer/core && go mod download all
RUN cd observer/controller && go mod download all

FROM registry.k8s.io/kubectl:v1.33.2@sha256:15ac68dd5ff1c5ef4c5ef85f2ef1a6e20903312ed10090e0c834ca8b156e331e AS kubectl

FROM node:22.17.0-bookworm-slim@sha256:b04ce4ae4e95b522112c2e5c52f781471a5cbc3b594527bcddedee9bc48c03a0 AS runtime
ARG CODEX_VERSION=0.144.0-alpha.4
LABEL org.opencontainers.image.title="SDO production runtime" \
      org.opencontainers.image.version="0.1.0"
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global "@openai/codex@${CODEX_VERSION}" \
    && npm cache clean --force
RUN python3 -m pip install --break-system-packages --no-cache-dir \
      pydantic==2.12.5 \
      pyyaml==6.0.3
ENV PATH="/usr/local/go/bin:${PATH}" \
    PYTHONPATH=/opt/sdo \
    HOME=/tmp \
    GOCACHE=/tmp/go-cache \
    GOMODCACHE=/go/pkg/mod \
    GOPROXY=off \
    GOSUMDB=off \
    GOMAXPROCS=2 \
    GOFLAGS=-p=2
COPY --from=go-runtime /usr/local/go /usr/local/go
COPY --from=go-runtime /go/pkg/mod /go/pkg/mod
COPY --from=go-runtime /opt/sdo/observer /opt/sdo/observer
COPY --from=kubectl /bin/kubectl /usr/local/bin/kubectl
COPY app_operator /opt/sdo/app_operator
WORKDIR /opt/sdo

FROM runtime AS controller
CMD ["python3", "-m", "observer.updater.check_cli", "controller", "--help"]

FROM runtime AS responder
CMD ["python3", "-m", "app_operator.protocol.job_responder"]

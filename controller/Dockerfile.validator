# syntax=docker/dockerfile:1.7

FROM golang:1.26.8-bookworm@sha256:a688600ca24f8a4d3ca77f95b0dd40704a9fc787c826660eb7ba0b641b8b175d AS go-runtime
WORKDIR /opt/sdo
# The validator runtime has no C compiler, so Go builds there with cgo off.
# Build cache keys include the cgo setting: seed with the same setting.
ENV GOCACHE=/go/build-cache \
    CGO_ENABLED=0
COPY controller/sdk ./controller/sdk
COPY controller/core ./controller/core
COPY controller/runtime ./controller/runtime
# The runtime module requires the generated proto-contracts module via a
# relative replace (../contracts); copy it so the build and the synthesized
# detector workspaces can resolve it without a network fetch.
COPY controller/contracts ./controller/contracts
COPY controller/builder ./controller/builder
RUN cd controller/sdk && go mod download all
RUN cd controller/core && go mod download all
RUN cd controller/runtime && go mod download all
RUN cd controller/sdk && go test -run '^$' ./...
RUN cd controller/core && go test -run '^$' ./...
RUN cd controller/runtime && go test -run '^$' ./...

FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db
# Pin the embedded schema identity into the image (seam 4,
# docs/seam-contracts-decisions.md). scripts/build_sdo_images.sh computes it from
# the SDK/manifest sources being baked; the sandbox's --expect-schema startup
# check and `docker image inspect` both surface a stale image.
ARG SDO_VALIDATOR_SCHEMA_IDENTITY="unknown"
LABEL org.opencontainers.image.title="SDO detector validator" \
      org.opencontainers.image.version="0.1.0" \
      dev.sdo.validator-schema="${SDO_VALIDATOR_SCHEMA_IDENTITY}"
ENV PATH="/usr/local/go/bin:${PATH}" \
    PYTHONPATH=/opt/sdo
COPY --from=go-runtime /usr/local/go /usr/local/go
COPY --from=go-runtime /go/pkg/mod /go/pkg/mod
COPY --from=go-runtime /go/build-cache /opt/sdo/go-build-cache
COPY --from=go-runtime /opt/sdo/controller /opt/sdo/controller
RUN chmod -R a+rX /opt/sdo/controller
RUN python -m pip install --no-cache-dir --no-deps \
      annotated-types==0.7.0 \
      protobuf==6.33.4 \
      pydantic==2.12.5 \
      pydantic-core==2.41.5 \
      pyyaml==6.0.3 \
      typing-extensions==4.15.0 \
      typing-inspection==0.4.2
WORKDIR /opt/sdo
CMD ["python", "-m", "controller.builder.check_cli", "--help"]

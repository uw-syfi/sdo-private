# syntax=docker/dockerfile:1.7

FROM golang:1.24.5-bookworm@sha256:ef8c5c733079ac219c77edab604c425d748c740d8699530ea6aced9de79aea40 AS go-runtime
WORKDIR /opt/sdo
# The validator runtime has no C compiler, so Go builds there with cgo off.
# Build cache keys include the cgo setting: seed with the same setting.
ENV GOCACHE=/go/build-cache \
    CGO_ENABLED=0
COPY controller/sdk ./controller/sdk
COPY controller/core ./controller/core
COPY controller/runtime ./controller/runtime
COPY controller/builder ./controller/builder
RUN cd controller/sdk && go mod download all
RUN cd controller/core && go mod download all
RUN cd controller/runtime && go mod download all
RUN cd controller/sdk && go test -run '^$' ./...
RUN cd controller/core && go test -run '^$' ./...
RUN cd controller/runtime && go test -run '^$' ./...

FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db
LABEL org.opencontainers.image.title="SDO detector validator" \
      org.opencontainers.image.version="0.1.0"
ENV PATH="/usr/local/go/bin:${PATH}" \
    PYTHONPATH=/opt/sdo
COPY --from=go-runtime /usr/local/go /usr/local/go
COPY --from=go-runtime /go/pkg/mod /go/pkg/mod
COPY --from=go-runtime /go/build-cache /opt/sdo/go-build-cache
COPY --from=go-runtime /opt/sdo/controller /opt/sdo/controller
RUN chmod -R a+rX /opt/sdo/controller
RUN python -m pip install --no-cache-dir --no-deps \
      annotated-types==0.7.0 \
      pydantic==2.12.5 \
      pydantic-core==2.41.5 \
      pyyaml==6.0.3 \
      typing-extensions==4.15.0 \
      typing-inspection==0.4.2
WORKDIR /opt/sdo
CMD ["python", "-m", "controller.builder.check_cli", "--help"]

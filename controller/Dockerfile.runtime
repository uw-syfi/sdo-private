# syntax=docker/dockerfile:1.7

FROM golang:1.24.5-bookworm@sha256:ef8c5c733079ac219c77edab604c425d748c740d8699530ea6aced9de79aea40 AS go-runtime
WORKDIR /opt/sdo
COPY controller/sdk ./controller/sdk
COPY controller/core ./controller/core
COPY controller/runtime ./controller/runtime
COPY controller/builder ./controller/builder
RUN cd controller/sdk && go mod download all
RUN cd controller/core && go mod download all
RUN cd controller/runtime && go mod download all

FROM registry.k8s.io/kubectl:v1.33.2@sha256:15ac68dd5ff1c5ef4c5ef85f2ef1a6e20903312ed10090e0c834ca8b156e331e AS kubectl

FROM node:22.17.0-bookworm-slim@sha256:b04ce4ae4e95b522112c2e5c52f781471a5cbc3b594527bcddedee9bc48c03a0 AS runtime
ARG CODEX_VERSION=0.144.0-alpha.4
ARG CLAUDE_CODE_VERSION=2.1.258
LABEL org.opencontainers.image.title="SDO production runtime" \
      org.opencontainers.image.version="0.1.0"
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global "@openai/codex@${CODEX_VERSION}" "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && npm cache clean --force
RUN python3 -m pip install --break-system-packages --no-cache-dir \
      loguru==0.7.3 \
      pydantic==2.12.5 \
      pyyaml==6.0.3
ENV PATH="/usr/local/go/bin:${PATH}" \
    PYTHONPATH=/opt/sdo \
    HOME=/tmp \
    GOCACHE=/tmp/go-cache \
    GOMODCACHE=/go/pkg/mod \
    GOPROXY=off \
    GOSUMDB=off \
    GOMAXPROCS=2 \
    GOFLAGS=-p=2
COPY --from=go-runtime /usr/local/go /usr/local/go
COPY --from=go-runtime /go/pkg/mod /go/pkg/mod
COPY --from=go-runtime /opt/sdo/controller /opt/sdo/controller
COPY --from=kubectl /bin/kubectl /usr/local/bin/kubectl
COPY sdo /opt/sdo/sdo
COPY libs/__init__.py /opt/sdo/libs/__init__.py
COPY libs/agent_cli /opt/sdo/libs/agent_cli
RUN chmod -R a+rX /opt/sdo/controller /opt/sdo/sdo /opt/sdo/libs
WORKDIR /opt/sdo

FROM runtime AS controller
CMD ["python3", "-m", "controller.builder.check_cli", "controller", "--help"]

FROM runtime AS responder
CMD ["python3", "-m", "sdo.agent_runtime.responder.job"]

FROM responder AS sregym-responder
COPY benchmarks /opt/sdo/benchmarks
RUN chmod -R a+rX /opt/sdo/benchmarks

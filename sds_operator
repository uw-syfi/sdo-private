#!/bin/bash

# Get the directory of the script
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

if ! command -v uv >/dev/null 2>&1; then
    echo "Error: 'uv' is not installed. Please install 'uv' to continue."
    exit 1
fi

if [ -z "$1" ]; then
    echo "Usage: $0 <app-dir> [options]"
    exit 1
fi

uv run -m app_operator run "$@"
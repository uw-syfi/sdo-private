digraph tach_modules {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor="#e8f4f8", fontname="Helvetica"];
    edge [color="#666666"];

    "libs.pydantic_agent" -> "libs.model_config";
    "libs.agent_mw" -> "libs.pydantic_agent";
    "libs.agent_cli" -> "libs.sds_core";
    "app_operator.trajectory" -> "app_operator.prompts";
    "app_operator.trajectory" -> "libs.agent_cli";
    "app_operator.cli_agent" -> "app_operator.prompts";
    "app_operator.cli_agent" -> "app_operator.trajectory";
    "app_operator.cli_agent" -> "libs.agent_cli";
    "app_operator.__main__" -> "app_operator.commands";
    "sregym_agents" -> "libs.pydantic_agent";
    "sregym_agents" -> "libs.agent_mw";
    "sregym_agents" -> "libs.agent_cli";
}
